  <!-- Hero Section -->
  <section class="hero-dark">
    <div class="container text-center" style="max-width: 860px; margin: 0 auto; padding-bottom: 60px;">
      <div class="badge badge-dark-gold" style="margin-bottom: 14px;">
        <span>INTERACTIVE EXECUTIVE DIAGNOSTIC &bull; 2-MINUTE AUDIT</span>
      </div>
      <h1 style="color: #ffffff; margin-bottom: 14px; font-size: clamp(2.1rem, 4vw, 3.2rem); font-family: 'Space Grotesk', sans-serif;">
        What&rsquo;s Your Team&rsquo;s Drift Risk Score?
      </h1>
      <p style="font-size: 1.15rem; color: #cbd5e1; line-height: 1.65; margin-bottom: 0;">
        Leadership drift rarely announces itself as failure. It creeps in when systems fail to keep pace with growth. Rate 12 friction indicators to calculate your <strong>0&ndash;100 Risk Score</strong>, pinpoint your primary system leak, and receive your immediate First Move.
      </p>
    </div>
  </section>

  <!-- Main Diagnostic App Container -->
  <main class="diagnostic-wrapper">
    <div class="diagnostic-card" id="diagnostic-app">
      <!-- Dynamic View Managed by JS -->
    </div>
  </main>

  <!-- Grounding Section: The 4 Operating Systems -->
  <section class="section section-alt" style="padding-top: 20px;">
    <div class="container" style="max-width: 900px;">
      <div class="text-center" style="margin-bottom: 40px;">
        <div class="badge badge-gold" style="margin-bottom: 12px;">Methodology</div>
        <h2 style="color: var(--navy-900); font-size: 1.9rem; margin-bottom: 12px;">
          The Architecture of Organizational Drift
        </h2>
        <p style="color: var(--slate-600); max-width: 680px; margin: 0 auto; font-size: 1.05rem;">
          Based on the diagnostic frameworks in <em>Leadership Drift</em> by Kristen Peloquin, operational breakdown occurs across four predictable seams:
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
        <div class="card" style="padding: 24px; border: 1px solid var(--slate-200); border-radius: var(--radius-md);">
          <div style="color: var(--gold-500); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 6px;">System One</div>
          <h3 style="font-size: 1.15rem; color: var(--navy-900); margin-bottom: 8px;">Decision Architecture</h3>
          <p style="font-size: 0.9rem; color: var(--slate-600); line-height: 1.55; margin-bottom: 0;">
            Eliminating consensus paralysis, live rescues, and bottlenecked calendars through the <em>Rule of the Single &lsquo;A&rsquo;</em>.
          </p>
        </div>

        <div class="card" style="padding: 24px; border: 1px solid var(--slate-200); border-radius: var(--radius-md);">
          <div style="color: var(--gold-500); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 6px;">System Two</div>
          <h3 style="font-size: 1.15rem; color: var(--navy-900); margin-bottom: 8px;">Accountability Loop</h3>
          <p style="font-size: 0.9rem; color: var(--slate-600); line-height: 1.55; margin-bottom: 0;">
            Decoupling performance feedback from interpersonal conflict using uncancelable 1-on-1s and the <em>48-Hour Feedback Log</em>.
          </p>
        </div>

        <div class="card" style="padding: 24px; border: 1px solid var(--slate-200); border-radius: var(--radius-md);">
          <div style="color: var(--gold-500); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 6px;">System Three</div>
          <h3 style="font-size: 1.15rem; color: var(--navy-900); margin-bottom: 8px;">Capacity Blueprint</h3>
          <p style="font-size: 0.9rem; color: var(--slate-600); line-height: 1.55; margin-bottom: 0;">
            Protecting high performers and halting hidden burnout with the strict <em>Priority Kill Switch (1-in, 1-out)</em>.
          </p>
        </div>

        <div class="card" style="padding: 24px; border: 1px solid var(--slate-200); border-radius: var(--radius-md);">
          <div style="color: var(--gold-500); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; margin-bottom: 6px;">System Four</div>
          <h3 style="font-size: 1.15rem; color: var(--navy-900); margin-bottom: 8px;">Rules of Engagement</h3>
          <p style="font-size: 0.9rem; color: var(--slate-600); line-height: 1.55; margin-bottom: 0;">
            Resolving interdepartmental friction, turf disputes, and dropped handoffs through standardized <em>Seam Handoff Standards</em>.
          </p>
        </div>
      </div>
    </div>
  </section>

