  <!-- Diagnostic Script Engine -->
  <script>
  (function(){
    // The 12 Diagnostic Questions mapping to the 4 Systems & Archetypes
    const QUESTIONS = [
      {
        q: "Decisions stall when you or specific key leaders are unavailable or stuck in back-to-back meetings.",
        k: "rescuer",
        zone: "Decisions & Authority",
        system: "Decision Architecture"
      },
      {
        q: "A difficult conversation or critical feedback gets postponed to &ldquo;a better time.&rdquo;",
        k: "avoider",
        zone: "Culture & Feedback",
        system: "Accountability Loop"
      },
      {
        q: "A new &ldquo;top priority&rdquo; appears without anything of equal weight being explicitly paused or killed.",
        k: "overloader",
        zone: "Capacity & Workload",
        system: "Capacity Blueprint"
      },
      {
        q: "Customers experience the friction seams between your departments (dropped handoffs, finger-pointing).",
        k: "silo",
        zone: "Cross-Functional Seams",
        system: "Rules of Engagement"
      },
      {
        q: "Problems get solved faster by escalating to leadership than by trusting the frontline process.",
        k: "rescuer",
        zone: "Decisions & Authority",
        system: "Decision Architecture"
      },
      {
        q: "A known performance or behavior issue has been discussed for months without formal action.",
        k: "avoider",
        zone: "Culture & Feedback",
        system: "Accountability Loop"
      },
      {
        q: "Your strongest, most reliable performers get rewarded with more work while others skate by.",
        k: "overloader",
        zone: "Capacity & Workload",
        system: "Capacity Blueprint"
      },
      {
        q: "A decision gets quietly reopened, second-guessed, or renegotiated after it was already agreed upon.",
        k: "silo",
        zone: "Cross-Functional Seams",
        system: "Rules of Engagement"
      },
      {
        q: "You fix urgent problems personally because it feels faster than training or explaining the standard.",
        k: "rescuer",
        zone: "Decisions & Authority",
        system: "Decision Architecture"
      },
      {
        q: "Weekly 1-on-1s frequently get canceled, rescheduled, or turn into rushed tactical status updates.",
        k: "avoider",
        zone: "Culture & Feedback",
        system: "Accountability Loop"
      },
      {
        q: "Spreadsheets and dashboards show available capacity, while the frontline drowns in untracked shadow work (system freezes, rework, manual workarounds, and escalations).",
        k: "overloader",
        zone: "Capacity & Workload",
        system: "Capacity Blueprint"
      },
      {
        q: "Peer department heads resolve disputes by lobbying executive leadership rather than working it out directly.",
        k: "silo",
        zone: "Cross-Functional Seams",
        system: "Rules of Engagement"
      }
    ];

    const SCORING = [
      { text: "Always", sub: "Chronic pattern &bull; High friction", pts: 3 },
      { text: "Often", sub: "Frequent occurrence &bull; Persistent issue", pts: 2 },
      { text: "Sometimes", sub: "Occasional occurrence &bull; Emerging risk", pts: 1 },
      { text: "Rarely / Never", sub: "Controlled &bull; High operational discipline", pts: 0 }
    ];

    const ARCHETYPES = {
      rescuer: {
        name: "The Rescuer",
        systemName: "Decision Architecture",
        tagline: "Your team doesn&rsquo;t have an execution problem. It has a bottleneck problem.",
        desc: "Decisions route through key individuals instead of clear operating boundaries. Rescues feel productive in the moment, but the team has learned that waiting for you is safer than deciding independently.",
        traps: ["Charisma Dependency Cycle", "Leadership Bottleneck", "Hero Fa&ccedil;ade"],
        cost: "Learned helplessness, stalled velocity whenever key leaders travel, and burnout at the top.",
        move: "Install the Decision Architecture. This week, publish one clear decision boundary: three specific operational calls the frontline must execute without you. Then refuse the next rescue.",
        chapters: "Chapters 1&ndash;5 &bull; Part II: System One",
        tool: "Decision Architecture Matrix"
      },
      avoider: {
        name: "The Avoider",
        systemName: "Accountability Loop",
        tagline: "Your culture isn&rsquo;t broken. It has just accumulated avoidance debt.",
        desc: "Hard conversations get delayed in the name of kindness, 1-on-1s get canceled, and performance compromises compound silently. Every delay feels polite today, but produces surprise exits tomorrow.",
        traps: ["Avoidance Debt Trap", "Illusion of Kindness", "Tolerance Trade Trap", "Triangulation Trap"],
        cost: "Unclear standards, festering peer conflict, and top performers demoralized by tolerated mediocrity.",
        move: "Install the Accountability Loop. Reinstate non-negotiable weekly 1-on-1s (rescheduled, never canceled) and introduce a written 48-Hour Feedback Log after tough discussions.",
        chapters: "Chapters 6&ndash;9 &bull; Part II: System Two",
        tool: "48-Hour Feedback Log & Contract"
      },
      overloader: {
        name: "The Overloader",
        systemName: "Capacity Blueprint",
        tagline: "Your team isn&rsquo;t underperforming. It&rsquo;s buried under priority creep.",
        desc: "Everything is declared urgent, the dashboard looks green, and capacity is treated as infinite. The most reliable people absorb the tax until exhaustion or quiet quitting takes hold.",
        traps: ["Ambiguity Burnout Trap", "Reliability Tax Trap", "Green Dashboard Trap", "Capacity Mirage"],
        cost: "Attrition of your best problem solvers, hidden rework, and mistaking urgent activity for strategic progress.",
        move: "Install the Capacity Blueprint. Enforce the Priority Kill Switch: for every new corporate initiative launched, one existing initiative of equal weight must be explicitly paused or killed.",
        chapters: "Chapters 10&ndash;14 &bull; Part II: System Three",
        tool: "Priority Kill Switch Template"
      },
      silo: {
        name: "The Silo Builder",
        systemName: "Rules of Engagement",
        tagline: "Your departments are winning their metrics. Your company is losing the customer.",
        desc: "Functional units optimize for their own scorecard while the handoffs between them remain undefined. Peers lobby upwards instead of resolving disputes at the seam.",
        traps: ["Turf War", "Protecting the Silo", "Re-Org Void Trap", "Pressure Hiring Trap"],
        cost: "Dropped customer handoffs, duplicated overhead, and friction between departmental leaders.",
        move: "Install the Rules of Engagement. Align your two most frictional departments under one shared KPI they win or lose together, and document their internal SLA on a single sheet.",
        chapters: "Chapters 15&ndash;19 &bull; Part II: System Four",
        tool: "Seam Handoff Standard"
      }
    };

    const BANDS = [
      { max: 25, badgeClass: "risk-low", tag: "Low Drift Risk", name: "Anchored Alignment",
        desc: "Operational discipline is intact. Decisions move with velocity, feedback is candid, capacity is respected, and handoffs hold. Your focus now is proactive maintenance: run quarterly seam audits and guard against complacency." },
      { max: 50, badgeClass: "risk-early", tag: "Early Warning", name: "Emerging Drift",
        desc: "The operation still delivers, but internal warning lights are flashing. Friction is beginning to concentrate in one or two seams. This is the most cost-effective window to install systems before it costs you key people." },
      { max: 75, badgeClass: "risk-deep", tag: "High Friction", name: "Deep Structural Drift",
        desc: "This is a systemic pattern, not a temporary rough patch. Overloaded teams are avoiding hard conversations, and siloed functions are escalating everything back to leadership. You need operating frameworks, not more effort." },
      { max: 100, badgeClass: "risk-critical", tag: "Severe Exposure", name: "Critical Heroics Drift",
        desc: "The operation is currently held together by individual heroics rather than repeatable systems. Key leaders are single points of failure, burnout is imminent, and the customer is experiencing the internal seams." }
    ];

    const ORDER = ["rescuer", "avoider", "overloader", "silo"];
    const LABELS = {
      rescuer: "Decisions (Rescue Risk)",
      avoider: "Accountability (Avoidance Risk)",
      overloader: "Capacity (Overload Risk)",
      silo: "Seams (Silo Friction)"
    };

    // ========================================================
    // LEAD CAPTURE CONFIGURATION (Web3Forms -> kristen@klpconsultingsvcs.org)
    // Replace ee876766-2b71-4ab8-888b-6cb3f57d469d with your Web3Forms Access Key from https://web3forms.com
    // ========================================================
    const WEB3FORMS_ACCESS_KEY = "ee876766-2b71-4ab8-888b-6cb3f57d469d";

    let state = {
      step: 0,
      answers: [],
      scores: { rescuer: 0, avoider: 0, overloader: 0, silo: 0 },
      email: "",
      name: ""
    };

    const app = document.getElementById("diagnostic-app");

    function renderStart() {
      app.innerHTML = `
        <div class="diag-kicker">Executive Diagnostic &bull; 12 Questions</div>
        <h2 style="font-size: 1.85rem; color: var(--navy-900); margin-bottom: 12px; font-family: 'Space Grotesk', sans-serif;">
          Diagnose Your Team&rsquo;s Operational Health
        </h2>
        <p style="color: var(--slate-700); font-size: 1.05rem; line-height: 1.6; margin-bottom: 20px;">
          This 2-minute clinical diagnostic measures the subtle friction patterns that slow organizational velocity. Rate how frequently each operational statement occurs on your team to generate your benchmarked report.
        </p>

        <div class="intro-grid">
          <div class="intro-item">
            <h4>1. Quantifiable Risk Score</h4>
            <p>A benchmarked 0&ndash;100 score classifying your drift level from Anchored to Critical.</p>
          </div>
          <div class="intro-item">
            <h4>2. Dominant System Leak</h4>
            <p>Pinpoints which of the 4 core operating zones is bleeding the most velocity.</p>
          </div>
          <div class="intro-item">
            <h4>3. Leadership Trap Archetype</h4>
            <p>Identifies your team&rsquo;s default operating trap from the book <em>Leadership Drift</em>.</p>
          </div>
          <div class="intro-item">
            <h4>4. Immediate First Move</h4>
            <p>A concrete, non-theoretical protocol you can implement with your team this week.</p>
          </div>
        </div>

        <div style="text-align: center; margin-top: 8px;">
          <button class="btn btn-primary btn-lg" style="box-shadow: 0 4px 18px rgba(197, 155, 39, 0.35); font-size: 1.1rem; padding: 16px 36px;" onclick="window.startDiagnostic()">
            Start the 2-Minute Diagnostic &rarr;
          </button>
        </div>
      `;
    }

    window.startDiagnostic = function() {
      state.step = 0;
      state.answers = [];
      state.scores = { rescuer: 0, avoider: 0, overloader: 0, silo: 0 };
      renderQuestion();
    };

    function renderQuestion() {
      const idx = state.step;
      const total = QUESTIONS.length;

      if (idx >= total) {
        renderGate();
        return;
      }

      const q = QUESTIONS[idx];
      const progressPct = Math.round((idx / total) * 100);

      let optionsHtml = '';
      SCORING.forEach((opt, optIndex) => {
        optionsHtml += `
          <button class="diag-opt-btn" onclick="window.chooseAnswer('${q.k}', ${opt.pts})">
            <div>
              <div style="font-size: 1.05rem; margin-bottom: 2px;">${opt.text}</div>
              <div class="diag-opt-sub">${opt.sub}</div>
            </div>
            <span style="color: var(--gold-500); font-size: 1.25rem;">&rarr;</span>
          </button>
        `;
      });

      app.innerHTML = `
        <div class="diag-step-counter">
          <span>Statement ${idx + 1} of ${total}</span>
          <span class="diag-zone-badge">${q.zone}</span>
        </div>

        <div class="diag-progress-bar">
          <div class="diag-progress-fill" style="width: ${progressPct}%;"></div>
        </div>

        <div class="diag-question-text">${q.q}</div>
        <div class="diag-question-prompt">How frequently does this pattern occur across your team or organization?</div>

        <div class="diag-options-grid">
          ${optionsHtml}
        </div>

        <div class="diag-nav-row">
          ${idx > 0 ? `<button class="btn btn-outline btn-sm" onclick="window.previousQuestion()">&larr; Back</button>` : `<span></span>`}
          <span style="font-size: 0.8rem; color: var(--slate-400);">Confidential Assessment</span>
        </div>
      `;

      app.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    window.chooseAnswer = function(key, pts) {
      state.scores[key] += pts;
      state.answers.push({ key: key, pts: pts });
      state.step++;
      renderQuestion();
    };

    window.previousQuestion = function() {
      if (state.step > 0) {
        state.step--;
        const last = state.answers.pop();
        if (last) {
          state.scores[last.key] -= last.pts;
        }
        renderQuestion();
      }
    };

    function topKey() {
      let best = ORDER[0];
      ORDER.forEach(k => {
        if (state.scores[k] > state.scores[best]) {
          best = k;
        }
      });
      return best;
    }

    function renderGate() {
      app.innerHTML = `
        <div class="diag-progress-bar">
          <div class="diag-progress-fill" style="width: 100%;"></div>
        </div>
        <div class="badge badge-gold" style="margin-bottom: 12px;">Diagnostic Complete</div>
        <h2 style="font-size: 1.85rem; color: var(--navy-900); margin-bottom: 10px; font-family: 'Space Grotesk', sans-serif;">
          Your Drift Report Is Ready
        </h2>
        <p style="color: var(--slate-700); font-size: 1.05rem; line-height: 1.6; margin-bottom: 24px;">
          Enter your details below to save your official Drift Risk Score and receive the companion operating tools referenced in <em>Leadership Drift</em>.
        </p>

        <div style="background: var(--navy-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 22px; margin-bottom: 24px;">
          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--navy-900); margin-bottom: 6px;">Your Name</label>
            <input type="text" id="diag-name" class="form-control" placeholder="e.g. Kristen Peloquin" style="width: 100%; padding: 12px 14px; border: 1px solid var(--slate-200); border-radius: var(--radius-sm); font-size: 1rem;">
          </div>
          <div>
            <label style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--navy-900); margin-bottom: 6px;">Work Email Address</label>
            <input type="email" id="diag-email" class="form-control" placeholder="you@company.com" style="width: 100%; padding: 12px 14px; border: 1px solid var(--slate-200); border-radius: var(--radius-sm); font-size: 1rem;">
          </div>
        </div>

        <div class="cta-button-group">
          <button class="btn btn-primary btn-lg" style="box-shadow: 0 4px 18px rgba(197, 155, 39, 0.35);" onclick="window.submitGate()">
            Reveal My Official Results &rarr;
          </button>
          <button class="btn btn-outline btn-lg" onclick="window.renderResults()">
            Skip &bull; Just View Result
          </button>
        </div>

        <p style="font-size: 0.82rem; color: var(--slate-400); margin-top: 18px;">
          Your information is held in strict professional confidence. No spam. Unsubscribe anytime.
        </p>
      `;

      app.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    window.submitGate = function() {
      const nameVal = (document.getElementById("diag-name")?.value || "").trim();
      const emailVal = (document.getElementById("diag-email")?.value || "").trim();

      if (emailVal && emailVal.indexOf("@") < 1) {
        alert("Please enter a valid email address to receive your report.");
        return;
      }

      state.name = nameVal;
      state.email = emailVal;

      if (emailVal) {
        const S = state.scores;
        const rawTotal = S.rescuer + S.avoider + S.overloader + S.silo;
        const score = Math.round((rawTotal / 36) * 100);
        const leakKey = topKey();
        const A = ARCHETYPES[leakKey];

        let band = BANDS[3];
        for (let i = 0; i < BANDS.length; i++) {
          if (score <= BANDS[i].max) {
            band = BANDS[i];
            break;
          }
        }

        // Save lead securely to local storage as fallback
        try {
          localStorage.setItem("klp_diagnostic_lead_email", emailVal);
          localStorage.setItem("klp_diagnostic_lead_name", nameVal);
          localStorage.setItem("klp_diagnostic_last_score", JSON.stringify({
            date: new Date().toISOString(),
            scores: state.scores,
            email: emailVal,
            name: nameVal,
            score: score,
            band: band.name,
            archetype: A.title
          }));
        } catch(e) {}

        // Send instant lead email notification via Web3Forms endpoint
        if (typeof WEB3FORMS_ACCESS_KEY !== "undefined" && WEB3FORMS_ACCESS_KEY && WEB3FORMS_ACCESS_KEY !== "ee876766-2b71-4ab8-888b-6cb3f57d469d") {
          fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify({
              access_key: WEB3FORMS_ACCESS_KEY,
              subject: `New Drift Risk Lead: ${nameVal || 'Leader'} scored ${score}/100 (${A.title})`,
              from_name: "Leadership Drift Diagnostic",
              name: nameVal || "Anonymous Leader",
              email: emailVal,
              drift_risk_score: `${score}/100 - ${band.name} (${band.tag})`,
              primary_friction_archetype: A.title,
              estimated_operational_drag: A.cost,
              recommended_first_move: A.move,
              relevant_framework: A.framework,
              book_chapters: A.chapters,
              score_breakdown: `Rescue: ${S.rescuer}/9 | Avoidance: ${S.avoider}/9 | Overload: ${S.overloader}/9 | Silo: ${S.silo}/9`,
              submitted_at: new Date().toLocaleString()
            })
          }).catch(function(err) {
            console.warn("Lead email notification failed:", err);
          });
        }

        // Fire analytics tracking event
        if (typeof window.trackEvent === 'function') {
          window.trackEvent('diagnostic_lead_captured', {
            email: emailVal,
            name: nameVal,
            score: score,
            archetype: A.title
          });
        }
      }

      window.renderResults();
    };

    window.renderResults = function() {
      const S = state.scores;
      const rawTotal = S.rescuer + S.avoider + S.overloader + S.silo;
      // 12 questions * max 3 = 36 max raw points
      const score = Math.round((rawTotal / 36) * 100);
      const leakKey = topKey();
      const A = ARCHETYPES[leakKey];

      let band = BANDS[3];
      for (let i = 0; i < BANDS.length; i++) {
        if (score <= BANDS[i].max) {
          band = BANDS[i];
          break;
        }
      }

      // Track diagnostic completion
      if (typeof window.trackEvent === 'function') {
        window.trackEvent('diagnostic_completed', {
          score: score,
          band: band.name,
          leak_system: A.systemName,
          email: state.email
        });
      }

      // Render breakdown rows
      let breakdownHtml = "";
      ORDER.forEach(k => {
        const pct = Math.round((S[k] / 9) * 100);
        const isTop = (k === leakKey);
        breakdownHtml += `
          <div class="breakdown-row ${isTop ? 'top-leak' : ''}">
            <div class="breakdown-label">${LABELS[k]}</div>
            <div class="breakdown-track">
              <div class="breakdown-fill" style="width: ${pct}%;"></div>
            </div>
            <div class="breakdown-pct">${pct}%</div>
          </div>
        `;
      });

      // Render pills
      let pillsHtml = "";
      A.traps.forEach(trap => {
        pillsHtml += `<span class="trap-pill">${trap}</span>`;
      });

      const isAnchored = (score <= 25);

      app.innerHTML = `
        <div class="score-circle-wrapper">
          <div class="score-display-number">${score}<span>/100</span></div>
          <div><span class="risk-badge ${band.badgeClass}">${band.tag} &bull; ${band.name}</span></div>
        </div>

        <div style="border-top: 1px solid var(--slate-200); padding-top: 24px; margin-top: 12px;">
          <h3 style="font-size: 1.5rem; color: var(--navy-900); margin-bottom: 8px; font-family: 'Space Grotesk', sans-serif;">
            Diagnosis: ${isAnchored ? 'Anchored Alignment &bull; Systems Are Holding' : band.name}
          </h3>
          <p style="color: var(--slate-700); font-size: 1.05rem; line-height: 1.6; margin-bottom: 24px;">
            ${isAnchored 
              ? 'Your operational discipline is intact. Decisions move with clarity, feedback loops are direct, capacity boundaries hold, and cross-departmental handoffs are clean. Your priority now is proactive maintenance so standards do not slip as your organization scales.'
              : band.desc}
          </p>

          <div style="background: var(--navy-50); border: 1.5px solid var(--slate-200); border-radius: var(--radius-md); padding: 24px; margin-bottom: 24px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
              <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold-500);">
                ${isAnchored ? 'Primary Seam to Watch as You Scale' : 'Primary Friction Seam'}
              </span>
              <span style="font-size: 0.8rem; font-weight: 600; color: var(--slate-400);">${A.chapters}</span>
            </div>
            <h4 style="font-size: 1.3rem; color: var(--navy-900); margin-bottom: 4px;">
              ${isAnchored ? A.systemName : `${A.name} &bull; ${A.systemName}`}
            </h4>
            <p style="font-style: italic; color: var(--slate-600); margin-bottom: 12px; font-size: 0.95rem;">
              &ldquo;${A.tagline}&rdquo;
            </p>
            <p style="color: var(--slate-700); font-size: 0.95rem; line-height: 1.6; margin-bottom: 14px;">
              ${isAnchored 
                ? `Even in disciplined organizations, <strong>${A.systemName}</strong> is often the first place friction quietly creeps in when team size expands or new managers join. Protect your operational boundaries before growth taxes your best people.` 
                : `With <strong>${A.name}</strong> patterns identified across your team, ${A.desc.toLowerCase()}`}
            </p>
            
            ${!isAnchored ? `
              <div style="font-size: 0.85rem; font-weight: 700; color: var(--navy-900); margin-bottom: 6px;">Identified Book Traps:</div>
              <div class="trap-pills">${pillsHtml}</div>
              <p style="font-size: 0.9rem; color: var(--slate-700); margin-bottom: 0;">
                <strong>Organizational Cost:</strong> ${A.cost}
              </p>
            ` : `
              <div style="font-size: 0.85rem; font-weight: 700; color: var(--navy-900); margin-bottom: 6px;">Relevant Core Tool:</div>
              <span class="trap-pill" style="background: #e2e8f0; color: var(--navy-900);">${A.tool}</span>
            `}
          </div>

          <div class="first-move-box">
            <strong>${isAnchored ? 'Recommended Maintenance Move:' : 'Your Recommended First Move:'}</strong>
            <p>${isAnchored 
              ? `Run a quarterly intent vs. impact seam audit across <strong>${A.systemName}</strong>, and equip your frontline and mid-level managers with the frameworks in <em>Leadership Drift</em> to prevent executive backsliding.` 
              : A.move}
            </p>
          </div>

          <div style="margin: 28px 0;">
            <h4 style="font-size: 1.15rem; color: var(--navy-900); margin-bottom: 14px;">
              Where Your Operational Friction Concentrates:
            </h4>
            <div class="breakdown-table">
              ${breakdownHtml}
            </div>
          </div>

          <!-- DIRECT AMAZON BOOK PRESCRIPTION CARD -->
          <div style="background: linear-gradient(135deg, #fdfbf7 0%, #f7f1e1 100%); border: 2px solid var(--gold-400); border-radius: var(--radius-md); padding: 26px 24px; margin: 30px 0; box-shadow: 0 8px 24px rgba(197, 155, 39, 0.12);">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
              <span style="font-size: 1.25rem;">📖</span>
              <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold-600);">
                Your Prescribed Blueprint in Leadership Drift
              </span>
            </div>
            <h4 style="font-size: 1.35rem; color: var(--navy-950); margin-bottom: 8px; font-family: 'Space Grotesk', sans-serif;">
              ${isAnchored ? 'Scale and Protect Your Standards' : `Eliminate ${A.systemName} Friction`}
            </h4>
            <p style="color: var(--slate-700); font-size: 0.98rem; line-height: 1.6; margin-bottom: 18px;">
              ${isAnchored 
                ? 'Your systems are holding today. Use <em>Leadership Drift</em> as your organization&rsquo;s operational playbook to train incoming leaders, eliminate single points of failure, and maintain velocity through high growth.' 
                : `Turn to <strong>${A.chapters}</strong> in <em>Leadership Drift</em> to install the <strong>${A.tool}</strong>, establish unambiguous decision boundaries, and eliminate untracked operational drag before it burns out top talent.`}
            </p>
            <div class="cta-button-group" style="margin-top: 0;">
              <a href="https://a.co/d/01zgwPxE" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="box-shadow: 0 4px 14px rgba(197, 155, 39, 0.4); font-weight: 700; padding: 12px 24px;">
                Order on Amazon ($19.99) &bull; Prime &rarr;
              </a>
              <a href="https://a.co/d/01zgwPxE" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="border-color: var(--navy-800); color: var(--navy-900); font-weight: 600; padding: 12px 20px;">
                Kindle &bull; Free on KU
              </a>
            </div>
          </div>

          <!-- KLP CONSULTING ENTERPRISE ADVISORY CARD -->
          <div style="background: var(--navy-900); color: #ffffff; border-radius: var(--radius-md); padding: 26px; margin: 30px 0;">
            <h4 style="color: #ffffff; font-size: 1.25rem; margin-bottom: 8px; font-family: 'Space Grotesk', sans-serif;">
              Install These Operating Systems on Your Team
            </h4>
            <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">
              Kristen Peloquin leads executive advisory, private operational alignment workshops, and leadership team audits to systematically install decision rights, resolve seams, and eliminate drift.
            </p>
            <div class="cta-button-group" style="margin-top: 0;">
              <a href="schedule.html" class="btn btn-primary btn-sm">
                Schedule Discovery Call with Kristen &rarr;
              </a>
              <a href="tools.html" class="btn btn-outline btn-sm" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
                Free Reader Portal Tools
              </a>
              <a href="enterprise.html" class="btn btn-outline btn-sm" style="color: #ffffff; border-color: rgba(255,255,255,0.4);">
                Enterprise Playbook Sprint
              </a>
            </div>
          </div>

          <div style="text-align: center; margin-top: 20px;">
            <button class="btn btn-outline btn-sm" onclick="window.startDiagnostic()">
              &circlearrowleft; Retake Assessment
            </button>
          </div>
        </div>
      `;

      app.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    // Initialize Diagnostic
    renderStart();
  })();
  </script>
  <script src="script.js"></script>
</body>
</html>
