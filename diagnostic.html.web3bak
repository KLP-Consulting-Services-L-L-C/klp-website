<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Executive Drift Diagnostic | What&rsquo;s Your Drift Risk Score? | Leadership Drift</title>
  <meta name="description" content="Take the 2-minute executive diagnostic based on Leadership Drift by Kristen Peloquin. Calculate your team's Drift Risk Score (0–100), identify your biggest operational leak, and get your immediate First Move.">
  <link rel="icon" type="image/png" href="assets/favicon.png">
  <link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
  <link rel="stylesheet" href="styles.css">
  <link rel="canonical" href="https://klpconsultingsvcs.org/diagnostic.html">
  <meta property="og:title" content="Executive Drift Diagnostic | Leadership Drift">
  <meta property="og:description" content="Calculate your team's Drift Risk Score (0–100) and pinpoint your highest-friction operational leak in 2 minutes.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://klpconsultingsvcs.org/diagnostic.html">

  <style>
    /* Specific styles for the interactive diagnostic */
    .diagnostic-wrapper {
      max-width: 800px;
      margin: -40px auto 80px auto;
      padding: 0 20px;
      position: relative;
      z-index: 10;
    }

    .diagnostic-card {
      background: #ffffff;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: 40px 36px;
      box-shadow: 0 20px 45px -10px rgba(11, 19, 43, 0.12), 0 10px 20px -5px rgba(11, 19, 43, 0.06);
    }

    @media (max-width: 640px) {
      .diagnostic-card {
        padding: 26px 20px;
      }
      .diagnostic-wrapper {
        margin-top: -20px;
      }
    }

    .diag-kicker {
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold-500);
      font-weight: 700;
      margin-bottom: 8px;
    }

    .diag-progress-bar {
      height: 8px;
      background: var(--slate-100);
      border-radius: var(--radius-full);
      margin-bottom: 24px;
      overflow: hidden;
      border: 1px solid var(--slate-200);
    }

    .diag-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--gold-400), var(--gold-500));
      border-radius: var(--radius-full);
      transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .diag-step-counter {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--slate-600);
      margin-bottom: 12px;
    }

    .diag-zone-badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      background: var(--navy-100);
      color: var(--navy-800);
    }

    .diag-question-text {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--navy-900);
      line-height: 1.4;
      margin-bottom: 8px;
    }

    .diag-question-prompt {
      font-size: 0.95rem;
      color: var(--slate-600);
      margin-bottom: 22px;
    }

    .diag-options-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .diag-opt-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      text-align: left;
      background: var(--navy-50);
      border: 1.5px solid var(--slate-200);
      border-radius: var(--radius-md);
      padding: 16px 20px;
      font-size: 1rem;
      font-weight: 600;
      color: var(--navy-900);
      cursor: pointer;
      transition: all 0.18s ease;
      font-family: inherit;
    }

    .diag-opt-btn:hover {
      border-color: var(--gold-400);
      background: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(11, 19, 43, 0.06);
    }

    .diag-opt-btn:active {
      transform: translateY(0);
    }

    .diag-opt-sub {
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--slate-600);
    }

    .score-circle-wrapper {
      text-align: center;
      margin: 10px 0 24px 0;
    }

    .score-display-number {
      font-size: clamp(3.5rem, 8vw, 5.2rem);
      font-weight: 800;
      line-height: 1;
      color: var(--navy-950);
      font-family: 'Space Grotesk', sans-serif;
    }

    .score-display-number span {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--slate-400);
    }

    .risk-badge {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 6px 18px;
      border-radius: var(--radius-full);
      margin-top: 8px;
    }

    .risk-low { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .risk-early { background: #fef9c3; color: #854d0e; border: 1px solid #fef08a; }
    .risk-deep { background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }
    .risk-critical { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }

    .first-move-box {
      background: #fdfaf2;
      border-left: 4px solid var(--gold-500);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      padding: 20px 22px;
      margin: 24px 0;
      border-top: 1px solid #f9edd0;
      border-right: 1px solid #f9edd0;
      border-bottom: 1px solid #f9edd0;
    }

    .first-move-box strong {
      display: block;
      color: var(--navy-900);
      font-size: 1.05rem;
      margin-bottom: 6px;
    }

    .first-move-box p {
      color: var(--slate-700);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 0;
    }

    .trap-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 12px 0 18px 0;
    }

    .trap-pill {
      background: var(--navy-100);
      color: var(--navy-800);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 5px 14px;
      border-radius: var(--radius-full);
      border: 1px solid var(--slate-200);
    }

    .breakdown-table {
      margin: 20px 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .breakdown-row {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 0.9rem;
    }

    .breakdown-label {
      width: 140px;
      font-weight: 700;
      color: var(--navy-900);
      flex-shrink: 0;
    }

    .breakdown-track {
      flex: 1;
      height: 10px;
      background: var(--slate-100);
      border-radius: var(--radius-full);
      overflow: hidden;
      border: 1px solid var(--slate-200);
    }

    .breakdown-fill {
      height: 100%;
      background: var(--navy-700);
      border-radius: var(--radius-full);
      transition: width 0.6s ease;
    }

    .breakdown-row.top-leak .breakdown-fill {
      background: var(--gold-500);
    }

    .breakdown-pct {
      width: 44px;
      text-align: right;
      font-weight: 700;
      color: var(--slate-600);
      flex-shrink: 0;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 24px 0 32px 0;
    }

    @media (max-width: 600px) {
      .intro-grid {
        grid-template-columns: 1fr;
      }
    }

    .intro-item {
      background: var(--navy-50);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      padding: 16px;
    }

    .intro-item h4 {
      font-size: 0.95rem;
      color: var(--navy-900);
      margin-bottom: 4px;
    }

    .intro-item p {
      font-size: 0.85rem;
      color: var(--slate-600);
      line-height: 1.5;
      margin-bottom: 0;
    }

    .cta-button-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
    }

    .diag-nav-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--slate-100);
    }
  </style>
</head>
